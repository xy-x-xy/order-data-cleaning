import pandas as pd
df=pd.read_csv('customer_orders.csv',encoding='utf-8',sep=',')
def qian(df):
    print('清洗前检查')
    #1.数据总览
    print('\n1.数据总览')
    print(f'总行数{len(df)}')
    print(f'总列数{len(df.columns)}')
    #2.空值检查
    print('\n2.空值检查')
    null_count=df.isna().sum()
    if null_count.sum()==0:
        print('无空值')
    else:
        for col in null_count[null_count>0].index:
            rows=df[col][df[col].isna()].index.tolist()
            print(f'{col}:{null_count[col]}个空值,行数{rows}')
    #3.特殊符号检查
    print('\n3.特殊符号检查')
    for col in df.columns:
        mask=df[col].astype(str).str.strip().isin([',','一','￥'])
        count=mask.sum()
        if count>0:
            rows=df[mask].index.tolist()
            print(f'{col}:{count}个特殊符号,行数{rows}')
    #4.类型检查
    print('\n4.类型检查')
    for col in df.columns:
        dtype=str(df[col].dtype)
        if ('date' in col or 'time' in col) and 'datetime' not in dtype:
            print(f'{col}应该为datetime类型,实际为{dtype}')
        elif (col in ['price','quantity','total','salary'] or 'age' in col) and dtype not in ['int64','float64','Int64']:
            print(f'{col}应该为数字类型,实际为{dtype}')
    #5.数字检查
    print('\n5.数字检查')
    for col in df.select_dtypes(include=['int64','float64','Int64']).columns:
        neg=(df[col]<0).sum()
        zero=(df[col]==0).sum()
        if neg>0:
            print(f'{col}:{neg}个负数')
        elif zero>0:
            print(f'{col}:{zero}个零值')
    # 6. 唯一值分布检查（发现“别名”问题）
    print('\n6. 唯一值分布检查')
    for col in df.select_dtypes(include=['object']).columns:
        # 跳过明显是唯一标识的列（如订单号、客户名）
        if col in ['order_id', 'customer_name']:
            continue
        unique_vals = df[col].unique()
        print(f'\n{col} ({len(unique_vals)} 种取值)：')
        # 如果取值种类少于等于 10 种，全部打印出来
        if len(unique_vals) <= 10:
            print(unique_vals.tolist())
        else:
            # 如果取值太多，只打印前 10 个作为样例
            print(f'(太多了，只显示前 10 个) {unique_vals[:10].tolist()}')

qian(df)
def auto_data(df,a):
    df_clean=df.copy()
    for col,rule in a.items():
        if col not in df_clean.columns:
            continue
        #1.替换特殊符号
        if 'replace' in rule:
            for old,new in rule['replace'].items():
                df_clean[col]=df_clean[col].astype(str).str.replace(old,new,regex=False)
        #2.类型转换
        if 'astype' in rule:
            astype=rule['astype']
            if astype=='int':
                df_clean[col]=pd.to_numeric(df_clean[col],errors='coerce').astype('Int64')
            elif astype=='float':
                df_clean[col]=pd.to_numeric(df_clean[col],errors='coerce').astype(float)
            elif astype=='datetime':
                df_clean[col]=pd.to_datetime(df_clean[col],format='mixed',errors='coerce')
        #3.别名处理
        if 'map' in rule:
            df_clean[col]=df_clean[col].replace(rule['map'])
        #4.负数处理
        if 'neg' in rule:
            df_clean[col]=df_clean[col].abs()
        #5.空值处理
        if 'fillna' in rule:
            x=rule['fillna']
            if x=='mode':
                y=df_clean[col][df_clean[col].notna()].mode()
                fillna_value=y[0] if not y.empty else 0
            elif x=='median':
                y=df_clean[col][df_clean[col].notna()].median()
                fillna_value=y if pd.notna(y) else 0
            elif x=='mean':
                y=df_clean[col][df_clean[col].notna()].mean()
                fillna_value=y if pd.notna(y) else 0
            df_clean[col]=df_clean[col].fillna(fillna_value)
        #6.零值处理
        if 'zero' in rule:
            x=rule['zero']
            if x=='mode':
                y=df_clean[col][df_clean[col]>0].mode()
                zero_value=y[0] if not y.empty else 1
            else:
                zero_value=x
            df_clean[col]=df_clean[col].apply(lambda x:zero_value if(isinstance(x,(int,float)) and x<=0)else x)
    df_clean['total']=df_clean['price']*df_clean['quantity']
    return df_clean
a={'order_date':{'astype':'datetime'},
   'quantity':{'zero':'mode'},
   'store_name':{'map':{'FR02':'芙蓉店','芙蓉路':'芙蓉店','万佳丽':'万家丽','五一广场店':'五一店','WY01':'五一店'}}}
df_clean=auto_data(df,a)
